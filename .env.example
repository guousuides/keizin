# ============================================================
# 夏合宿 競馬企画 — 環境変数設定ファイル
# ============================================================

# サーバー起動ポート番号（省略時は 3000）
PORT=3000

# 運営画面のURLパス（省略時は /admin）
# 例: /kanri や /secret-admin などに変更可能
ADMIN_PATH=/admin

# ------------------------------------------------------------
# Vercel / クラウドデプロイ用 (Upstash Redis / Vercel KV)
# ※ ローカルPCで動かす（node server.js）だけなら設定不要です。
# ------------------------------------------------------------
# Upstash Console (https://console.upstash.com) の REST API 欄から取得
KV_REST_API_URL=
KV_REST_API_TOKEN=

# または Upstash 標準のキー名でも設定可能です:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
